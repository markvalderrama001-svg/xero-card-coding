# Copy to .env (never commit it) and load it into your shell, or set these as environment variables.
# Create an app at https://developer.xero.com/app/manage (Web app, auth-code flow).
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:8765/callback

# Where the OAuth token pair is stored locally (gitignored). Xero rotates the refresh token on every refresh.
XERO_TOKEN_FILE=.xero_tokens.json

# Xero AccountID of the credit-card bank account the transactions post to.
XERO_CARD_ACCOUNT_ID=your-card-bank-account-id

# Tracking category used to split costs across brands/companies, and accounts that never carry it.
XERO_TRACKING_CATEGORY=Brand
CARD_UNTRACKED_ACCOUNTS=3100

# Lines below this confidence go to a human.
CARD_CONFIDENCE_THRESHOLD=0.8
